# Integration tests — fingerprint, baseline, timestamp, config, scan pipeline
# Crosses multiple modules (types + hashing + analyze + report).

include "src/lib.cyr"

fn test_fingerprint() {
    test_group("fingerprint");

    # ScanTarget.data is a Str, not a raw cstr — finding_fingerprint and all
    # three report renderers read it as one.
    var target = scan_target_file(str_from("test.bin"));
    assert(str_eq(load64(target + 8), str_from("test.bin")), "target.data is a Str");
    var f = finding_new(target, CATEGORY_MALWARE, SEVERITY_HIGH, str_from("test_rule"), str_from("test desc"));
    var fp = finding_fingerprint(f);
    assert_eq(str_len(fp), 64, "fingerprint is 64 chars");

    # Deterministic
    var fp2 = finding_fingerprint(f);
    assert(str_eq(fp, fp2), "fingerprint is deterministic");

    # Different rule = different fingerprint
    var f2 = finding_new(target, CATEGORY_MALWARE, SEVERITY_HIGH, str_from("other_rule"), str_from("test desc"));
    var fp3 = finding_fingerprint(f2);
    assert_eq(str_eq(fp, fp3), 0, "different rule = different fingerprint");
}

fn test_baseline() {
    test_group("baseline");

    var content = str_from("# comment\ntest_rule\n\n");
    var b = baseline_from_ignore_file(content);
    assert_eq(baseline_is_empty(b), 0, "baseline not empty");
    assert_eq(baseline_len(b), 1, "baseline has 1 entry");

    # Suppression by rule name
    var target = scan_target_file(str_from("test.bin"));
    var f = finding_new(target, CATEGORY_SUSPICIOUS, SEVERITY_LOW, str_from("test_rule"), str_from("desc"));
    assert(baseline_is_suppressed(b, f), "finding suppressed by rule name");

    var f2 = finding_new(target, CATEGORY_SUSPICIOUS, SEVERITY_LOW, str_from("other_rule"), str_from("desc"));
    assert_eq(baseline_is_suppressed(b, f2), 0, "other rule not suppressed");
}

fn test_timestamp() {
    test_group("timestamp");

    # Known epoch: 2026-01-01 00:00:00 UTC = 1767225600
    var ts = phylax_timestamp(1767225600);
    assert(str_len(ts) > 0, "timestamp not empty");
    # Should start with "2026-"
    var d = str_data(ts);
    assert_eq(load8(d), 50, "starts with '2'");
    assert_eq(load8(d + 1), 48, "second char '0'");
    assert_eq(load8(d + 2), 50, "third char '2'");
    assert_eq(load8(d + 3), 54, "fourth char '6'");
}

fn test_config() {
    test_group("config");

    # Config loading with no file should not crash
    # (load_config returns 0 when no config found)
    assert(1, "config loading doesn't crash");
}

fn test_scan_pipeline() {
    test_group("scan_pipeline");

    # scan_result_new creates valid result
    var target = scan_target_file(str_from("test.bin"));
    var result = scan_result_new(target);
    assert(result != 0, "scan_result created");
    assert_eq(scan_result_has_threats(result), 0, "new result has no threats");
    assert_eq(scan_result_finding_count(result), 0, "new result count = 0");

    # Add a finding and check
    var f = finding_new(target, CATEGORY_MALWARE, SEVERITY_HIGH,
      str_from("test"), str_from("desc"));
    vec_push(load64(result + 8), f);
    assert(scan_result_has_threats(result), "result has threats");
    assert_eq(scan_result_finding_count(result), 1, "result count = 1");

    # finding_is_critical
    assert_eq(finding_is_critical(f), 0, "HIGH is not critical");
    var fc = finding_new(target, CATEGORY_MALWARE, SEVERITY_CRITICAL,
      str_from("crit"), str_from("desc"));
    assert(finding_is_critical(fc), "CRITICAL is critical");
}

# ----------------------------------------------------------------
# http_post against a real listener. Until 1.2.8 http_post passed the URL's
# host C STRING to sock_connect, which takes a packed IPv4 address, so it never
# reached any server -- and no test noticed, because none had a server to
# reach. This forks a one-shot HTTP server on 127.0.0.1, POSTs to it by literal
# address and by name, and checks the status and body the server sent.
# ----------------------------------------------------------------

# Child side: accept one connection, read the request, answer 200 "ok", exit.
# Never returns -- the child must not fall through into the parent's asserts.
fn http_one_shot_server(lfd) {
    var ct, cfd = sock_accept(lfd);
    if (is_err_result(ct) == 0) {
        var buf = alloc(4096);
        var rt, rn = sock_recv(cfd, buf, 4096);
        var resp = "HTTP/1.0 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok";
        var st, sn = sock_send(cfd, resp, strlen(resp));
        sys_close(cfd);
    }
    sys_close(lfd);
    sys_exit(0);
    return 0;
}

# Bind a loopback listener on the first free port in a small fixed range.
# Returns the port (the listening fd is stored at out_fd), or 0.
fn http_test_listen(out_fd) {
    var port = 47311;
    while (port < 47341) {
        var lt, lfd = tcp_socket();
        if (is_err_result(lt) == 1) { return 0; }
        var bt, bv = sock_bind(lfd, INADDR_LOOPBACK(), port);
        if (is_err_result(bt) == 0) {
            var st, sv = sock_listen(lfd, 4);
            if (is_err_result(st) == 0) {
                store64(out_fd, lfd);
                return port;
            }
        }
        sys_close(lfd);
        port = port + 1;
    }
    return 0;
}

# POST to `url_host`:port through a freshly forked one-shot server and return
# the http_post response struct ({status, body_ptr, body_len}), or 0.
fn http_post_via_server(url_host) {
    var lfd_slot = alloc(8);
    var port = http_test_listen(lfd_slot);
    if (port == 0) { return 0; }
    var lfd = load64(lfd_slot);
    var pid = sys_fork();
    if (pid == 0) { http_one_shot_server(lfd); }
    sys_close(lfd);
    var url = str_cat(str_cat(str_from("http://"), str_from(url_host)), str_from(":"));
    url = str_cat(str_cat(url, str_from_int(port)), str_from("/probe"));
    var resp = http_post(str_to_cstr(url), str_from("{}"), "application/json");
    # A regressed http_post never connects, so reap the child either way.
    sys_kill(pid, 9);
    var wst = alloc(8);
    sys_waitpid(pid, wst, 0);
    return resp;
}

fn test_http_post_roundtrip() {
    test_group("http_post_roundtrip");

    # Each step is guarded so that a REGRESSED http_post fails these assertions
    # instead of dereferencing its zeroed error response and killing the run.
    var r1 = http_post_via_server("127.0.0.1");
    assert(r1 != 0, "listener came up on a loopback port");
    if (r1 != 0) {
        assert_eq(load64(r1), 200, "POST to 127.0.0.1 reaches the server (status 200)");
        assert_eq(load64(r1 + 16), 2, "response body length is 2");
        var body_ok = 0;
        if (load64(r1 + 8) != 0 && load64(r1 + 16) == 2) { body_ok = memeq(load64(r1 + 8), "ok", 2); }
        assert_eq(body_ok, 1, "response body is the server's 'ok'");
    }

    var r2 = http_post_via_server("localhost");
    assert(r2 != 0, "second listener came up");
    if (r2 != 0) { assert_eq(load64(r2), 200, "POST to localhost resolves and reaches the server"); }

    var r3 = http_post("http://phylax-no-such-host.invalid:1/x", str_from("{}"), "application/json");
    assert_eq(load64(r3), 0, "an unresolvable host returns the zeroed error response");
}

# ----------------------------------------------------------------
# MCP phylax_scan handler. bote hands a handler its "arguments" object as raw
# JSON text (a cstr). Until 1.3.1 the handler walked that text as parsed pairs
# and SIGSEGV'd the process on the first call (measured on 1.3.0: exit 139),
# and would have passed a Str where a path cstr is needed. Each call below is
# exactly what bote's dispatcher passes.
# ----------------------------------------------------------------

fn test_mcp_scan_handler() {
    test_group("mcp_scan_handler");
    file_write_all("/tmp/phylax-test-mcp.txt", "hello world", 11);

    # A handler returns a C string of JSON — the contract bote's dispatcher checks
    # (`jsonx_valid(result, strlen(result))`).
    var r = phylax_scan_handler("{\"target\":\"/tmp/phylax-test-mcp.txt\"}", 0);
    assert(r != 0, "handler returns a response");
    var root = 0;
    if (r != 0) { root = bayan_json_v_parse_buf(r, strlen(r)); }
    assert(root != 0, "the response is a JSON cstr");
    var sz = bayan_json_v_obj_get_by_cstr(root, "size");
    assert_eq(bayan_json_v_int(sz), 11, "it read the 11-byte target");
    var h = bayan_json_v_str(bayan_json_v_obj_get_by_cstr(root, "sha256"));
    assert(h != 0, "it carries a sha256");
    if (h != 0) { assert_eq(str_len(h), 64, "the sha256 is 64 hex chars"); }

    var e1 = phylax_scan_handler("{}", 0);
    assert(cstr_has(e1, "missing target"), "no target -> missing-target error");
    var e2 = phylax_scan_handler("{\"target\":42}", 0);
    assert(cstr_has(e2, "missing target"), "a non-string target -> missing-target error");
    var e3 = phylax_scan_handler("not json at all", 0);
    assert(cstr_has(e3, "missing target"), "unparseable arguments -> error, not a crash");
    var e4 = phylax_scan_handler(0, 0);
    assert(cstr_has(e4, "missing target"), "null arguments -> error, not a crash");
    var e5 = phylax_scan_handler("{\"target\":\"/tmp/phylax-no-such-file\"}", 0);
    assert(cstr_has(e5, "failed to read"), "a missing file -> read error");
    return 0;
}

# ----------------------------------------------------------------
# MCP end to end through bote: phylax_register_tools into a real bote registry
# + dispatcher, then genuine JSON-RPC lines through bote's own codec. Until
# 1.3.1 phylax passed every tool name, description and schema as a Str, which
# bote reads as a cstr: it refused all five tools (registry_len 0), the
# handler table was keyed by Str headers, and handlers returned Str where bote
# requires a JSON cstr. So the MCP surface could never answer a call.
# ----------------------------------------------------------------

# Send one JSON-RPC line through bote and return the serialized reply (cstr).
fn mcp_roundtrip(disp, line) {
    var req = codec_parse_request(line);
    if (req == 0) { return 0; }
    var resp = dispatcher_dispatch(disp, req, 0);
    if (resp == 0) { return 0; }
    return codec_serialize_response(resp);
}

fn test_mcp_bote_e2e() {
    test_group("mcp_bote_e2e");
    file_write_all("/tmp/phylax-test-mcp.txt", "hello world", 11);
    var reg = tool_registry_new();
    var disp = dispatcher_new(reg);
    phylax_register_tools(reg, disp);

    assert_eq(registry_len(reg), 5, "bote accepts all five phylax tools (was 0)");
    assert_eq(registry_contains(reg, "phylax_scan"), 1, "phylax_scan is registered by name");

    var list = mcp_roundtrip(disp, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}");
    assert(cstr_has(list, "\"phylax_scan\""), "tools/list names phylax_scan");
    assert(cstr_has(list, "\"phylax_quarantine\""), "tools/list names phylax_quarantine");

    var out = mcp_roundtrip(disp, mcp_scan_call("\"target\":\"/tmp/phylax-test-mcp.txt\",\"target_type\":\"file\""));
    assert(out != 0, "tools/call phylax_scan gets a reply");
    assert(cstr_has(out, "sha256"), "the reply carries the scan result");
    assert_eq(cstr_has(out, "\"isError\":true"), 0, "the reply is not a tool error");

    var sreq = str_from("{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",");
    sreq = str_cat(sreq, str_from("\"params\":{\"name\":\"phylax_status\",\"arguments\":{}}}"));
    var st = mcp_roundtrip(disp, str_to_cstr(sreq));
    assert(cstr_has(st, "ready"), "tools/call phylax_status reports ready");

    # bote judges phylax's inputSchema before a handler runs, so a handler may
    # trust the shape of its arguments. Pinned at 1.3.2 (bote 3.8.11; the same
    # answers on 3.8.6) because bote's schema enforcement moves every release.
    var bad = mcp_roundtrip(disp, mcp_scan_call("\"target\":\"/tmp/phylax-test-mcp.txt\",\"target_type\":\"bogus\""));
    assert(cstr_has(bad, "not in enum"), "a target_type outside the enum is refused before the handler");
    var nreq = mcp_roundtrip(disp, mcp_scan_call("\"target\":\"/tmp/phylax-test-mcp.txt\""));
    assert(cstr_has(nreq, "missing required field: target_type"), "a missing required argument is refused");
    var wty = mcp_roundtrip(disp, mcp_scan_call("\"target\":42,\"target_type\":\"file\""));
    assert(cstr_has(wty, "target: expected string"), "a wrongly-typed argument is refused");
    var dup_args = "\"target\":\"/tmp/x\",\"target\":\"/tmp/y\",\"target_type\":\"file\"";
    var dup = mcp_roundtrip(disp, mcp_scan_call(dup_args));
    assert(cstr_has(dup, "-32600"), "an argument named twice is an invalid request (bote 3.8.6+)");
    return 0;
}

# A tools/call line for phylax_scan whose arguments object holds `members` (cstr).
fn mcp_scan_call(members) {
    var s = str_from("{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"tools/call\",");
    s = str_cat(s, str_from("\"params\":{\"name\":\"phylax_scan\",\"arguments\":{"));
    s = str_cat(s, str_from(members));
    s = str_cat(s, str_from("}}}"));
    return str_to_cstr(s);
}

# 1 if cstr `s` contains cstr `needle`, else 0 (0 for a null `s`).
fn cstr_has(s, needle) {
    if (s == 0) { return 0; }
    return phylax_str_contains(str_from(s), str_from(needle));
}

fn main() {
    phylax_init();

    test_fingerprint();
    test_baseline();
    test_timestamp();
    test_config();
    test_scan_pipeline();
    test_http_post_roundtrip();
    test_mcp_scan_handler();
    test_mcp_bote_e2e();

    return assert_summary();
}

var exit_code = main();
sys_exit(exit_code);
