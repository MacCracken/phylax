# CLI pipeline — cli.cyr surface (rules validate, scan pipeline, arg helpers)
#
# cli.cyr is the binary-only module, so it is included on top of src/lib.cyr
# here; this file's main() shadows cli.cyr's (last definition wins).
#
# The point of this file is the cstr/Str boundary. Argv values reach the CLI
# as raw NUL-terminated cstrs, while everything downstream of collect_files
# is a Str fat pointer {data, len}. Reading one as the other takes the eight
# bytes past a cstr's NUL as a length, which is how `rules validate` and the
# unknown-command path SIGSEGV'd through 1.2.5.

include "src/lib.cyr"
include "src/cli.cyr"

var TMP_DIR   = "/tmp/phylax-test-cli";
var TMP_RULE  = "/tmp/phylax-test-cli/t.yar";
var TMP_PLAIN = "/tmp/phylax-test-cli/plain.txt";
var TMP_EXE   = "/tmp/phylax-test-cli/fake.exe";

fn write_fixture(path, content) {
    file_write_all(path, str_data(content), str_len(content));
    return 0;
}

fn setup_fixtures() {
    sys_mkdir(TMP_DIR, 448);
    write_fixture(TMP_RULE, str_from("rule t { strings: $a = \"MZ\" condition: $a }\n"));
    write_fixture(TMP_PLAIN, str_from("hello\n"));

    # An MZ header followed by a NOP run — trips the built-in IsPE and
    # NopSled rules, so the scan actually produces findings to render.
    var n = 256;
    var buf = alloc(n);
    store8(buf, 0x4D);      # 'M'
    store8(buf + 1, 0x5A);  # 'Z'
    for (var i = 2; i < n; i = i + 1) { store8(buf + i, 0x90); }
    file_write_all(TMP_EXE, buf, n);
    return 0;
}

# ----------------------------------------------------------------
# rules validate — argv cstrs through to the report lines
# ----------------------------------------------------------------

fn test_rules_validate() {
    test_group("rules_validate");

    # arg_collect_positional hands cmd_rules_validate raw argv cstrs, so
    # that is exactly what this feeds it.
    var files = vec_new();
    vec_push(files, TMP_RULE);
    assert_eq(cmd_rules_validate(files), 0, "valid rule file returns 0");

    # A path that cannot be read must report and return 1, not crash on
    # phylax_read_file's 0 return.
    var missing = vec_new();
    vec_push(missing, "/tmp/phylax-test-cli/definitely-not-here.yar");
    assert_eq(cmd_rules_validate(missing), 1, "unreadable file returns 1");

    # A readable file with no rules in it warns but is not an error.
    var norules = vec_new();
    vec_push(norules, TMP_PLAIN);
    assert_eq(cmd_rules_validate(norules), 0, "file with no rules returns 0");

    # Mixed batch: the error count survives a later success.
    var mixed = vec_new();
    vec_push(mixed, "/tmp/phylax-test-cli/definitely-not-here.yar");
    vec_push(mixed, TMP_RULE);
    assert_eq(cmd_rules_validate(mixed), 1, "one bad file in a batch returns 1");
}

# ----------------------------------------------------------------
# collect_files / run_scan — the cstr -> Str handoff
# ----------------------------------------------------------------

fn test_collect_files() {
    test_group("collect_files");

    # paths in, argv-style cstrs; files out, Strs.
    var paths = vec_new();
    vec_push(paths, TMP_DIR);
    var files = collect_files(paths, MAX_SCAN_FILE_SIZE);
    assert(vec_len(files) >= 2, "collected both fixture files");

    var first = vec_get(files, 0);
    assert(str_len(first) > 0, "collected path is a non-empty Str");
    assert_eq(load8(str_data(first)), 47, "collected path is absolute");
}

fn test_run_scan_target_is_str() {
    test_group("run_scan_target");

    # ScanTarget.data is a Str. It reaches the report renderers directly,
    # so run_scan must store the Str path, not the cstr it hands to
    # phylax_read_file.
    var result = run_scan(str_from(TMP_PLAIN), 0);
    assert(result != 0, "run_scan returned a result");

    var tdata = load64(load64(result) + 8);
    assert(tdata != 0, "target.data is populated");
    assert(str_eq(tdata, str_from(TMP_PLAIN)), "target.data is the path as a Str");

    # And it survives the full render pipeline that `phylax report` runs —
    # with a target that actually produces findings, which is the case that
    # crashed every renderer through 1.2.5.
    var hit = run_scan(str_from(TMP_EXE), 0);
    assert(vec_len(load64(hit + 8)) > 0, "the MZ/NOP fixture produced findings");

    var results = vec_new();
    vec_push(results, result);
    vec_push(results, hit);
    var report = report_from_results(str_from("phylax-cli-test"), results);

    var js = report_render_json(report);
    assert(json_v_is_obj(json_v_parse(js)) == 1, "json renders and reparses from run_scan results");
    assert(phylax_str_contains(js, str_from(TMP_EXE)), "json names the scanned path");

    var sf = report_render_sarif(report);
    assert(json_v_is_obj(json_v_parse(sf)) == 1, "sarif renders and reparses from run_scan results");
    assert(phylax_str_contains(sf, str_from(TMP_EXE)), "sarif names the scanned path");

    var md = report_render_markdown(report);
    assert(phylax_str_contains(md, str_from(TMP_EXE)), "markdown names the scanned path");
}

fn test_run_scan_rules_path() {
    test_group("run_scan_rules");

    # rules_path stays a raw argv cstr all the way to phylax_read_file.
    var result = run_scan(str_from(TMP_PLAIN), TMP_RULE);
    assert(result != 0, "run_scan with --rules returned a result");

    # A rules path that does not exist must be skipped, not dereferenced.
    var missing = run_scan(str_from(TMP_PLAIN), "/tmp/phylax-test-cli/nope.yar");
    assert(missing != 0, "run_scan with a missing --rules file returned a result");

    # An empty rules path is the "flag present but blank" case.
    var blank = run_scan(str_from(TMP_PLAIN), "");
    assert(blank != 0, "run_scan with a blank --rules path returned a result");
}

# ----------------------------------------------------------------
# --extensions filter
# ----------------------------------------------------------------

fn test_path_has_extension() {
    test_group("path_extension");

    assert_eq(path_has_extension(str_from("notes.txt"), str_from("txt")), 1, "bare suffix matches");
    assert_eq(path_has_extension(str_from("notes.txt"), str_from(".txt")), 1, "dotted suffix matches");
    assert_eq(path_has_extension(str_from("notes.txt"), str_from("exe")), 0, "wrong suffix does not match");
    assert_eq(path_has_extension(str_from("txt"), str_from("txt")), 0, "suffix without a dot does not match");
    assert_eq(path_has_extension(str_from("notes.txt"), str_from("")), 0, "empty suffix never matches");
    assert_eq(path_has_extension(str_from("notes.txt"), 0), 0, "null suffix never matches");

    # This is what main() builds from `--extensions txt,exe`.
    var exts = str_split(str_from("txt,exe"), str_from(","));
    assert_eq(vec_len(exts), 2, "--extensions splits into two entries");
    assert_eq(path_has_extension(str_from("a.exe"), vec_get(exts, 1)), 1, "split entry matches");
}

# ----------------------------------------------------------------
# watch: inotify mask. Until 1.2.8 cli.cyr re-declared WATCH_MASK as 0x18A on
# top of types.cyr's 266, so the library and the binary disagreed (the binary
# won, via last-definition-wins). This file compiles both, so it is where a
# re-introduced second definition would change the value under test.
# ----------------------------------------------------------------

fn test_watch_mask() {
    test_group("watch_mask");

    assert_eq(WATCH_MASK, 0x18A, "WATCH_MASK is the value phylax watch has always used");
    assert_eq(WATCH_MASK & IN_MOVED_TO, IN_MOVED_TO, "rename-into-place saves are watched");
    assert_eq(WATCH_MASK & IN_CLOSE_WRITE, IN_CLOSE_WRITE, "close-after-write is watched");
    assert_eq(WATCH_MASK, IN_MODIFY | IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE, "mask is exactly the four events");
}

# ----------------------------------------------------------------
# daemon: the AF_UNIX listening socket, end to end. Until 1.3.0 cmd_daemon
# made raw syscalls on x86_64 numbers from src/types.cyr; daemon_listen now
# uses the stdlib's per-target sys_* wrappers. Run this under
# `cyrius test --aarch64` too.
# ----------------------------------------------------------------

fn test_daemon_listen() {
    test_group("daemon_listen");
    var sock = "/tmp/phylax-test-cli/d.sock";

    var lfd = daemon_listen(sock);
    assert(lfd >= 0, "daemon_listen binds and listens");
    if (lfd < 0) { return 0; }

    # A client connects through the same path; the daemon side accepts it.
    var cfd = sys_socket(AF_UNIX, SOCK_STREAM, 0);
    assert(cfd >= 0, "client socket created");
    var addr = alloc(112);
    store16(addr, AF_UNIX);
    var plen = strlen(sock);
    memcpy(addr + 2, sock, plen);
    store8(addr + 2 + plen, 0);
    assert_eq(sys_connect(cfd, addr, 2 + plen + 1), 0, "client connects to the daemon socket");
    var afd = sys_accept4(lfd, 0, 0, 0);
    assert(afd >= 0, "daemon accepts the connection");

    # One byte across, so this is a real stream, not just a queued connect.
    var got = 0;
    if (afd >= 0) {
        sys_write(cfd, "x", 1);
        var b = alloc(8);
        if (sys_read(afd, b, 1) == 1) { got = load8(b); }
        sys_close(afd);
    }
    assert_eq(got, 120, "a byte written by the client reaches the daemon");
    sys_close(cfd);
    sys_close(lfd);

    assert_eq(daemon_listen("/tmp/phylax-no-such-dir/d.sock"), 0 - 2, "an unbindable path reports -2");
    return 0;
}

# ----------------------------------------------------------------
# config: phylax.toml lookups. Until 1.3.1 every key passed to bayan's
# cstr-keyed toml_get was a Str, so a parsed config set nothing (measured on
# 1.3.0). config_apply_toml is load_config minus the file read.
# ----------------------------------------------------------------

fn test_config_apply_toml() {
    test_group("config_toml");
    var cfg = "[scan]\nrules_path = \"/tmp/from-config.yar\"\nmax_file_size = \"4096\"\n\n";
    cfg = str_cat(str_from(cfg), str_from("[hoosh]\nurl = \"http://hoosh.example:9000\"\n\n"));
    cfg = str_cat(cfg, str_from("[daimon]\nurl = \"http://daimon.example:9001\"\n"));

    assert_eq(config_apply_toml(cfg), 1, "config parses");
    assert(CFG_RULES_PATH != 0, "[scan] rules_path is read (was ignored)");
    if (CFG_RULES_PATH != 0) {
        assert_eq(streq(CFG_RULES_PATH, "/tmp/from-config.yar"), 1, "rules_path is a NUL-terminated cstr of the value");
    }
    assert_eq(CFG_MAX_FILE_SIZE, 4096, "[scan] max_file_size is read");
    assert(CFG_HOOSH_URL != 0, "[hoosh] url is read");
    if (CFG_HOOSH_URL != 0) { assert_eq(streq(CFG_HOOSH_URL, "http://hoosh.example:9000"), 1, "hoosh url value"); }
    assert(CFG_DAIMON_URL != 0, "[daimon] url is read");
    if (CFG_DAIMON_URL != 0) { assert_eq(streq(CFG_DAIMON_URL, "http://daimon.example:9001"), 1, "daimon url value"); }
    assert_eq(config_apply_toml(0), 0, "a null body is refused");
    config_reset();
    return 0;
}

# ----------------------------------------------------------------
# --rules / config rules_path: a rules file is loaded into the (singleton)
# YARA engine once. Until 1.3.3 run_scan added it again for EVERY file, so in a
# directory scan file k carried k copies of each custom finding — invisible
# only because .yar rules never parsed (see test_yara.tcyr). With config
# supplying rules_path by default it would have hit every scan.
# ----------------------------------------------------------------

fn count_rule_findings(result, name) {
    var fs = load64(result + 8);
    var n = vec_len(fs);
    var c = 0;
    for (var i = 0; i < n; i = i + 1) {
        if (str_eq(load64(vec_get(fs, i) + 24), str_from(name))) { c = c + 1; }
    }
    return c;
}

fn test_custom_rules_load_once() {
    test_group("custom_rules_once");
    var rules = "/tmp/phylax-test-cli/once.yar";
    var body = str_from("rule OnceMarker {\n  strings:\n    $m = \"once_marker_77\"\n");
    write_fixture(rules, str_cat(body, str_from("  condition:\n    $m\n}\n")));
    write_fixture("/tmp/phylax-test-cli/once.txt", str_from("xx once_marker_77 yy\n"));
    var target = str_from("/tmp/phylax-test-cli/once.txt");
    var before = yara_engine_rule_count(get_yara_engine());
    for (var i = 0; i < 3; i = i + 1) {
        G_SCAN_ALLOC_TOTAL = 0;
        var r = run_scan(target, rules);
        assert_eq(count_rule_findings(r, "OnceMarker"), 1, "each scan reports the custom rule exactly once");
    }
    assert_eq(yara_engine_rule_count(get_yara_engine()), before + 1, "the rules file went into the engine once");
    return 0;
}

# ----------------------------------------------------------------
# config precedence (1.3.3): a CLI flag wins, then the config file, then the
# built-in default — what docs/guides/cli-reference.md always promised. Until
# 1.3.3 the CFG_* globals were written and never read.
# ----------------------------------------------------------------

fn test_config_precedence() {
    test_group("config_precedence");
    config_reset();

    # Nothing configured: flags pass through, defaults apply.
    assert_eq(config_rules_path(0), 0, "no flag, no config: no custom rules");
    assert_eq(streq(config_rules_path("/tmp/flag.yar"), "/tmp/flag.yar"), 1, "a --rules flag passes through");
    assert(str_eq(config_hoosh_url(0), str_from("http://localhost:8080")), "hoosh url default");
    assert_eq(config_scan_limit(), MAX_SCAN_FILE_SIZE, "scan size limit default (50 MB)");

    # A config file supplies the defaults; flags still win.
    var cfg = str_from("[scan]\nrules_path = \"/tmp/from-config.yar\"\nmax_file_size = 4096\n\n");
    cfg = str_cat(cfg, str_from("[hoosh]\nurl = \"http://hoosh.example:9000\"\n"));
    assert_eq(config_apply_toml(cfg), 1, "config parses");
    assert_eq(streq(config_rules_path(0), "/tmp/from-config.yar"), 1, "no flag: config rules_path applies");
    assert_eq(streq(config_rules_path("/tmp/flag.yar"), "/tmp/flag.yar"), 1, "--rules overrides config");
    assert(str_eq(config_hoosh_url(0), str_from("http://hoosh.example:9000")), "no flag: config hoosh url applies");
    assert(str_eq(config_hoosh_url("http://flag:1"), str_from("http://flag:1")), "--hoosh-url overrides config");
    assert_eq(config_scan_limit(), 4096, "an unquoted integer max_file_size applies");

    # max_file_size is validated, not trusted: phylax_str_to_int alone would
    # read "1MB" as 1 byte.
    config_reset();
    config_apply_toml(str_from("[scan]\nmax_file_size = \"1MB\"\n"));
    assert_eq(config_scan_limit(), MAX_SCAN_FILE_SIZE, "a non-numeric max_file_size is ignored");
    config_reset();
    config_apply_toml(str_from("[scan]\nmax_file_size = 0\n"));
    assert_eq(config_scan_limit(), MAX_SCAN_FILE_SIZE, "a zero max_file_size is ignored");
    config_reset();
    config_apply_toml(str_from("[scan]\nmax_file_size = 999999999999\n"));
    assert_eq(config_scan_limit(), PHYLAX_MAX_FILE_SIZE, "a max_file_size past the read cap is clamped to it");

    # An empty string value is "not set", not an empty path.
    config_reset();
    config_apply_toml(str_from("[scan]\nrules_path = \"\"\n\n[hoosh]\nurl = \"\"\n"));
    assert_eq(config_rules_path(0), 0, "an empty rules_path is not a rules file");
    assert(str_eq(config_hoosh_url(0), str_from("http://localhost:8080")), "an empty hoosh url keeps the default");

    # load_config records which file it applied.
    config_reset();
    assert_eq(CFG_SOURCE, 0, "config_reset clears the source");
    config_reset();
    return 0;
}

fn main() {
    phylax_init();
    setup_fixtures();

    test_rules_validate();
    test_collect_files();
    test_run_scan_target_is_str();
    test_run_scan_rules_path();
    test_path_has_extension();
    test_watch_mask();
    test_daemon_listen();
    test_config_apply_toml();
    test_custom_rules_load_once();
    test_config_precedence();

    return assert_summary();
}

var exit_code = main();
sys_exit(exit_code);
