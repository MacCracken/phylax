# SSDEEP (Context-Triggered Piecewise Hashing) — hashing.cyr surface

include "src/lib.cyr"

fn test_ssdeep() {
    test_group("ssdeep");

    # Empty returns 0
    var empty_hash = ssdeep_hash(alloc(1), 0);
    assert_eq(empty_hash, 0, "empty ssdeep = none");

    # Single byte produces hash
    var one = alloc(1);
    store8(one, 0x42);
    var h = ssdeep_hash(one, 1);
    assert(h != 0, "single byte produces hash");

    # Deterministic
    var data = alloc(1024);
    for (var i = 0; i < 1024; i = i + 1) {
        store8(data + i, i & 0xff);
    }
    var h1 = ssdeep_hash(data, 1024);
    var h2 = ssdeep_hash(data, 1024);
    assert(h1 != 0, "ssdeep hash produced");
    assert(h2 != 0, "ssdeep hash produced 2");
}

# ----------------------------------------------------------------
# Digest parsing. Until 1.3.3 parse_ssdeep_digest cut both hash fields with
# str_substr(digest, start, LENGTH) — the stdlib's str_substr takes an END
# index — so "3:abcdef:ghijk" parsed as h1 "bcde" and h2 "" (end before
# start). ssdeep_compare therefore scored truncated first halves and empty
# second halves.
# ----------------------------------------------------------------

fn ssd_handle(digest) {
    var h = alloc(16);
    store64(h, str_from(digest));
    return h;
}

fn test_ssdeep_digest_parse() {
    test_group("ssdeep_digest_parse");
    var bs = alloc(8);
    var h1 = alloc(8);
    var h2 = alloc(8);
    assert_eq(parse_ssdeep_digest(str_from("3:abcdef:ghijk"), bs, h1, h2), 1, "digest parses");
    assert_eq(load64(bs), 3, "block size");
    assert(str_eq(load64(h1), str_from("abcdef")), "first hash is the whole field (was 'bcde')");
    assert(str_eq(load64(h2), str_from("ghijk")), "second hash is the whole field (was empty)");

    # Same block size; the first halves differ only in their last 3 characters
    # (which the old parse cut off) and the second halves differ outright.
    var a = ssd_handle("96:abcdefghijklmnopqrstuvwxyzABCD:QRSTUVWXYZqrstuv");
    var b = ssd_handle("96:abcdefghijklmnopqrstuvwxyzAxyz:0123456789+/0123");
    # (phylax's score_strings subtracts log2(block size), so even identical
    # digests score below 100 — 94 at block size 96; the property that matters
    # is the ordering.)
    var same = ssdeep_compare(a, a);
    var near = ssdeep_compare(a, b);
    assert(same > near, "a digest scores higher against itself than against a near-miss (old parse: equal)");
    assert(near > 0, "a shared 27-character run still scores above 0");
}

fn main() {
    phylax_init();

    test_ssdeep();
    test_ssdeep_digest_parse();

    return assert_summary();
}

var exit_code = main();
sys_exit(exit_code);
