# Utility primitives — utils.cyr surface (memmem, hex encode/decode)

include "src/lib.cyr"

fn test_memmem() {
    test_group("memmem");

    var hay = str_from("hello world hello");
    var needle = str_from("world");
    var pos = memmem(str_data(hay), str_len(hay), str_data(needle), str_len(needle));
    assert_eq(pos, 6, "memmem finds world at 6");

    var miss = str_from("xyz");
    var pos2 = memmem(str_data(hay), str_len(hay), str_data(miss), str_len(miss));
    assert_eq(pos2, 0 - 1, "memmem returns -1 for miss");

    # Empty needle
    var pos3 = memmem(str_data(hay), str_len(hay), str_data(hay), 0);
    assert_eq(pos3, 0 - 1, "empty needle = -1");
}

fn test_memmem_variants() {
    test_group("memmem_variants");

    # Needle at start
    var hay = str_from("abcdefghij");
    var needle = str_from("abc");
    assert_eq(memmem(str_data(hay), str_len(hay), str_data(needle), str_len(needle)), 0, "needle at start");

    # Needle at end
    var needle2 = str_from("hij");
    assert_eq(memmem(str_data(hay), str_len(hay), str_data(needle2), str_len(needle2)), 7, "needle at end");

    # Needle at middle
    var needle3 = str_from("def");
    assert_eq(memmem(str_data(hay), str_len(hay), str_data(needle3), str_len(needle3)), 3, "needle at middle");

    # Single-byte needle
    var needle4 = str_from("a");
    assert_eq(memmem(str_data(hay), str_len(hay), str_data(needle4), str_len(needle4)), 0, "single byte at start");

    # Needle longer than haystack
    var short_hay = str_from("ab");
    var long_needle = str_from("abcde");
    assert_eq(memmem(str_data(short_hay), str_len(short_hay),
        str_data(long_needle), str_len(long_needle)),
      0 - 1, "needle longer than haystack");

    # Overlapping pattern: needle "aa" in "aaaa"
    var overlap_hay = str_from("aaaa");
    var overlap_needle = str_from("aa");
    assert_eq(memmem(str_data(overlap_hay), str_len(overlap_hay),
        str_data(overlap_needle), str_len(overlap_needle)),
      0, "overlapping at start");
}

fn test_hex() {
    test_group("hex");

    var data = alloc(3);
    store8(data, 0x4d); store8(data + 1, 0x5a); store8(data + 2, 0xff);
    var hex = phylax_hex_encode(data, 3);
    assert(str_eq(hex, str_from("4d5aff")), "hex_encode basic");

    # Empty
    var hex_empty = phylax_hex_encode(data, 0);
    assert_eq(str_len(hex_empty), 0, "hex_encode empty");
}

fn test_hex_decode() {
    test_group("hex_decode");

    # Basic roundtrip: encode then decode
    var orig = alloc(4);
    store8(orig, 0xDE); store8(orig + 1, 0xAD);
    store8(orig + 2, 0xBE); store8(orig + 3, 0xEF);
    var hex = phylax_hex_encode(orig, 4);
    assert(str_eq(hex, str_from("deadbeef")), "hex_encode deadbeef");

    var out_len = alloc(8);
    var decoded = phylax_hex_decode(hex, out_len);
    assert(decoded != 0, "hex_decode succeeds");
    assert_eq(load64(out_len), 4, "decoded length = 4");
    assert_eq(load8(decoded), 0xDE, "decoded[0] = 0xDE");
    assert_eq(load8(decoded + 1), 0xAD, "decoded[1] = 0xAD");
    assert_eq(load8(decoded + 2), 0xBE, "decoded[2] = 0xBE");
    assert_eq(load8(decoded + 3), 0xEF, "decoded[3] = 0xEF");

    # Odd-length hex string → failure
    var bad = str_from("abc");
    assert_eq(phylax_hex_decode(bad, out_len), 0, "odd length hex fails");

    # Invalid hex char → failure
    var bad2 = str_from("zz");
    assert_eq(phylax_hex_decode(bad2, out_len), 0, "invalid hex char fails");

    # Empty hex string → 0 bytes decoded
    var empty = str_from("");
    var dempty = phylax_hex_decode(empty, out_len);
    assert_eq(load64(out_len), 0, "empty hex decoded length = 0");
}

# ----------------------------------------------------------------
# phylax_read_file across PHYLAX_MMAP_THRESHOLD (64 KiB). Files at or below it
# take the heap path; above it, the mmap path, which fstat-checks S_ISREG.
# Until 1.2.8 that check used C-style octal (`0100000`), which Cyrius reads as
# DECIMAL, so it rejected every regular file and nothing over 64 KiB could be
# read. Every case below the threshold passed the whole time, which is why no
# test noticed.
# ----------------------------------------------------------------

var RF_DIR = "/tmp/phylax-test-utils";

# Write `size` bytes of a position-dependent pattern to `path`, then read it
# back through phylax_read_file and check length, first byte and last byte.
fn read_file_roundtrip(path, size) {
    var buf = alloc(size);
    for (var i = 0; i < size; i = i + 1) { store8(buf + i, (i * 7 + 3) & 0xff); }
    file_write_all(path, buf, size);
    G_SCAN_ALLOC_TOTAL = 0;
    var s = phylax_read_file(path);
    if (s == 0) { return 0; }
    if (str_len(s) != size) { return 0; }
    if (load8(str_data(s)) != 3) { return 0; }
    if (load8(str_data(s) + size - 1) != (((size - 1) * 7 + 3) & 0xff)) { return 0; }
    return 1;
}

fn test_read_file_sizes() {
    test_group("read_file_sizes");
    sys_mkdir(RF_DIR, 448);

    assert_eq(0o100000, 32768, "0o100000 is S_IFREG; a bare leading zero would be decimal");
    assert_eq(read_file_roundtrip("/tmp/phylax-test-utils/small.bin", 4096), 1, "4 KiB file reads (heap path)");
    assert_eq(read_file_roundtrip("/tmp/phylax-test-utils/at.bin", 65536), 1, "file at the 64 KiB threshold reads");
    assert_eq(read_file_roundtrip("/tmp/phylax-test-utils/over.bin", 65537), 1, "1 B over threshold reads (mmap)");
    assert_eq(read_file_roundtrip("/tmp/phylax-test-utils/big.bin", 1048576), 1, "1 MiB file reads (mmap path)");
    G_SCAN_ALLOC_TOTAL = 0;
    assert_eq(phylax_read_file("/tmp/phylax-test-utils/absent.bin"), 0, "missing file still returns 0");
}

fn main() {
    phylax_init();

    test_memmem();
    test_memmem_variants();
    test_hex();
    test_hex_decode();
    test_read_file_sizes();

    return assert_summary();
}

var exit_code = main();
sys_exit(exit_code);
