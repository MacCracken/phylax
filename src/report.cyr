# ================================================================
# Report — Structs
# ================================================================

struct ReportSummary {
    targets_scanned;       # i64
    targets_clean;         # i64
    targets_with_findings; # i64
    critical_count;        # i64
    high_count;            # i64
    medium_count;          # i64
    low_count;             # i64
    info_count;            # i64
}

struct ThreatReport {
    session_id;      # Str
    generated_at;    # Str (formatted timestamp)
    engine_version;  # Str
    results;         # Vec of ScanResult
    total_findings;  # i64
    summary;         # ReportSummary
}

# ================================================================
# Report — Build summary from scan results
# ================================================================

fn report_summary_new() {
    var s = alloc(64);
    store64(s, 0);
    store64(s + 8, 0);
    store64(s + 16, 0);
    store64(s + 24, 0);
    store64(s + 32, 0);
    store64(s + 40, 0);
    store64(s + 48, 0);
    store64(s + 56, 0);
    return s;
}

# `session_id` is a Str (see the struct comment above) — every renderer
# emits it as text. Passing a bare i64 here renders as a pointer-shaped
# integer in markdown and crashes the JSON/SARIF string emitters.
fn report_from_results(session_id, results) {
    var report = alloc(48);
    store64(report, session_id);
    store64(report + 8, phylax_timestamp(clock_epoch_secs()));
    store64(report + 16, VERSION);
    store64(report + 24, results);

    var summary = report_summary_new();
    var total = 0;
    var nresults = vec_len(results);

    store64(summary, nresults);

    for (var i = 0; i < nresults; i = i + 1) {
        var r = vec_get(results, i);
        var nfindings = vec_len(load64(r + 8));
        total = total + nfindings;

        if (nfindings == 0) {
            store64(summary + 8, load64(summary + 8) + 1);
        } else {
            store64(summary + 16, load64(summary + 16) + 1);
        }

        # Count by severity
        for (var j = 0; j < nfindings; j = j + 1) {
            var f = vec_get(load64(r + 8), j);
            if (load64(f + 16) == SEVERITY_CRITICAL) {
                store64(summary + 24, load64(summary + 24) + 1);
            }
            if (load64(f + 16) == SEVERITY_HIGH) {
                store64(summary + 32, load64(summary + 32) + 1);
            }
            if (load64(f + 16) == SEVERITY_MEDIUM) {
                store64(summary + 40, load64(summary + 40) + 1);
            }
            if (load64(f + 16) == SEVERITY_LOW) {
                store64(summary + 48, load64(summary + 48) + 1);
            }
            if (load64(f + 16) == SEVERITY_INFO) {
                store64(summary + 56, load64(summary + 56) + 1);
            }
        }
    }

    store64(report + 32, total);
    store64(report + 40, summary);
    return report;
}

# ================================================================
# Report — Str helpers shared by the renderers
# ================================================================

# A Str field on a report node may legitimately be 0: `scan_target_memory()`
# stores 0 for `ScanTarget.data`, and a consumer-built ThreatFinding may omit
# a description. Every renderer funnels Str reads through this so a 0 becomes
# an empty string instead of a load from address 8.
fn report_str_or_empty(s) {
    if (s == 0) { return str_from(""); }
    return s;
}

# Wrap a report Str as a JSON string value, tolerating a 0 field.
fn report_json_str(s) {
    return json_v_str_new(report_str_or_empty(s));
}

# ================================================================
# Report — JSON renderer
# ================================================================

# JSON is emitted through bayan's tagged-value tree (`json_v_*`), never the
# flat `json_build(pairs)` helper. `json_build` takes a Vec of 16-byte
# {key: Str, value: Str} pairs and stringifies every value — it cannot
# express nesting, integers or booleans. Handing it a HashMap (what this
# renderer did through 1.2.5) makes it read the map header's `cap` field as
# a vec length and walk the 24-byte entry array on an 8-byte stride, so it
# dereferences empty slots as pair pointers → SIGSEGV. `json_v_*` is typed,
# nests, and escapes strings at build time.
fn report_render_json(report) {
    var root = json_v_obj_new();
    json_v_obj_set(root, str_from("session_id"), report_json_str(load64(report)));
    json_v_obj_set(root, str_from("generated_at"), report_json_str(load64(report + 8)));
    json_v_obj_set(root, str_from("engine_version"), report_json_str(load64(report + 16)));
    json_v_obj_set(root, str_from("total_findings"), json_v_int_new(load64(report + 32)));

    # Summary object
    var s = load64(report + 40);
    var sm = json_v_obj_new();
    json_v_obj_set(sm, str_from("targets_scanned"), json_v_int_new(load64(s)));
    json_v_obj_set(sm, str_from("targets_clean"), json_v_int_new(load64(s + 8)));
    json_v_obj_set(sm, str_from("targets_with_findings"), json_v_int_new(load64(s + 16)));
    json_v_obj_set(sm, str_from("critical"), json_v_int_new(load64(s + 24)));
    json_v_obj_set(sm, str_from("high"), json_v_int_new(load64(s + 32)));
    json_v_obj_set(sm, str_from("medium"), json_v_int_new(load64(s + 40)));
    json_v_obj_set(sm, str_from("low"), json_v_int_new(load64(s + 48)));
    json_v_obj_set(sm, str_from("info"), json_v_int_new(load64(s + 56)));
    json_v_obj_set(root, str_from("summary"), sm);

    # Results array
    var results_arr = json_v_arr_new();
    var nresults = vec_len(load64(report + 24));
    for (var i = 0; i < nresults; i = i + 1) {
        var r = vec_get(load64(report + 24), i);
        var rm = json_v_obj_new();
        json_v_obj_set(rm, str_from("target"), report_json_str(load64(load64(r) + 8)));
        json_v_obj_set(rm, str_from("scan_duration_ms"), json_v_int_new(load64(r + 16)));

        var findings_arr = json_v_arr_new();
        var nf = vec_len(load64(r + 8));
        for (var j = 0; j < nf; j = j + 1) {
            var f = vec_get(load64(r + 8), j);
            var fm = json_v_obj_new();
            json_v_obj_set(fm, str_from("severity"), report_json_str(severity_name(load64(f + 16))));
            json_v_obj_set(fm, str_from("category"), report_json_str(category_name(load64(f + 8))));
            json_v_obj_set(fm, str_from("rule_name"), report_json_str(load64(f + 24)));
            json_v_obj_set(fm, str_from("description"), report_json_str(load64(f + 32)));
            json_v_obj_set(fm, str_from("timestamp"), json_v_int_new(load64(f + 48)));
            json_v_arr_push(findings_arr, fm);
        }
        json_v_obj_set(rm, str_from("findings"), findings_arr);
        json_v_arr_push(results_arr, rm);
    }
    json_v_obj_set(root, str_from("results"), results_arr);

    return json_v_build(root);
}

# ================================================================
# Report — Markdown renderer
# ================================================================

# Make a Str safe to drop into a markdown table cell: escape '|' (which
# would otherwise open a new column) and fold CR/LF to a space (which
# would otherwise end the row). Returns `s` untouched when there is
# nothing to rewrite, so the common path allocates nothing.
fn md_escape_pipe(s) {
    if (s == 0) { return str_from(""); }
    var len = str_len(s);
    var data = str_data(s);

    var needs_escape = 0;
    for (var i = 0; i < len; i = i + 1) {
        var ch = load8(data + i);
        if (ch == 0x7C) { needs_escape = 1; }
        if (ch == 0x0A) { needs_escape = 1; }
        if (ch == 0x0D) { needs_escape = 1; }
    }
    if (needs_escape == 0) { return s; }

    var sb = str_builder_new();
    for (var i = 0; i < len; i = i + 1) {
        var ch = load8(data + i);
        if (ch == 0x7C) {
            str_builder_add_byte(sb, 0x5C);  # '\'
            str_builder_add_byte(sb, ch);
        } elif (ch == 0x0A) {
            str_builder_add_byte(sb, 0x20);
        } elif (ch == 0x0D) {
            str_builder_add_byte(sb, 0x20);
        } else {
            str_builder_add_byte(sb, ch);
        }
    }
    return str_builder_build(sb);
}

# Append one markdown table cell: " <text> |". Rows open with a bare "|"
# and close with a newline, so cells compose into "| a | b |\n".
fn md_cell(sb, s) {
    str_builder_add_byte(sb, 0x20);
    str_builder_add(sb, md_escape_pipe(s));
    str_builder_add_cstr(sb, " |");
}

fn report_render_markdown(report) {
    var s = load64(report + 40);

    # str_builder, not repeated str_cat — str_cat copies the whole
    # accumulator on every append, which is quadratic in the number of
    # findings.
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "# Phylax Threat Report\n\n");
    str_builder_add_cstr(sb, "- **Session**: ");
    str_builder_add(sb, report_str_or_empty(load64(report)));
    str_builder_add_cstr(sb, "\n- **Generated**: ");
    str_builder_add(sb, report_str_or_empty(load64(report + 8)));
    str_builder_add_cstr(sb, "\n- **Engine**: phylax v");
    str_builder_add(sb, report_str_or_empty(load64(report + 16)));
    str_builder_add_cstr(sb, "\n- **Total Findings**: ");
    str_builder_add_int(sb, load64(report + 32));
    str_builder_add_cstr(sb, "\n\n");

    # Summary table
    str_builder_add_cstr(sb, "## Summary\n\n");
    str_builder_add_cstr(sb, "| Metric | Count |\n");
    str_builder_add_cstr(sb, "|--------|-------|\n");
    str_builder_add_cstr(sb, "| Targets Scanned | ");
    str_builder_add_int(sb, load64(s));
    str_builder_add_cstr(sb, " |\n| Clean | ");
    str_builder_add_int(sb, load64(s + 8));
    str_builder_add_cstr(sb, " |\n| With Findings | ");
    str_builder_add_int(sb, load64(s + 16));
    str_builder_add_cstr(sb, " |\n| Critical | ");
    str_builder_add_int(sb, load64(s + 24));
    str_builder_add_cstr(sb, " |\n| High | ");
    str_builder_add_int(sb, load64(s + 32));
    str_builder_add_cstr(sb, " |\n| Medium | ");
    str_builder_add_int(sb, load64(s + 40));
    str_builder_add_cstr(sb, " |\n| Low | ");
    str_builder_add_int(sb, load64(s + 48));
    str_builder_add_cstr(sb, " |\n| Info | ");
    str_builder_add_int(sb, load64(s + 56));
    str_builder_add_cstr(sb, " |\n\n");

    # Findings detail table
    str_builder_add_cstr(sb, "## Findings\n\n");
    str_builder_add_cstr(sb, "| Target | Severity | Category | Rule | Description |\n");
    str_builder_add_cstr(sb, "|--------|----------|----------|------|-------------|\n");

    var nresults = vec_len(load64(report + 24));
    for (var i = 0; i < nresults; i = i + 1) {
        var r = vec_get(load64(report + 24), i);
        var nf = vec_len(load64(r + 8));
        for (var j = 0; j < nf; j = j + 1) {
            var f = vec_get(load64(r + 8), j);
            str_builder_add_byte(sb, 0x7C);
            md_cell(sb, load64(load64(r) + 8));
            md_cell(sb, severity_name(load64(f + 16)));
            md_cell(sb, category_name(load64(f + 8)));
            md_cell(sb, load64(f + 24));
            md_cell(sb, load64(f + 32));
            str_builder_add_byte(sb, 0x0A);
        }
    }

    return str_builder_build(sb);
}

# ================================================================
# Report — SARIF v2.1.0 renderer
# ================================================================

var SARIF_SCHEMA_URI = "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json";
var PHYLAX_INFO_URI  = "https://github.com/MacCracken/phylax";

# SARIF's `startTimeUtc` is a §3.30.7 dateTime, i.e. RFC 3339 — a literal
# 'T' between date and time and a 'Z' zone designator. `phylax_timestamp`
# renders the human "YYYY-MM-DD HH:MM:SS" form used by markdown, so patch
# the two bytes rather than duplicating the civil-date math.
fn sarif_rfc3339(ts) {
    if (ts == 0) { return str_from(""); }
    if (str_len(ts) != 19) { return ts; }
    var src = str_data(ts);
    var buf = alloc(20);
    memcpy(buf, src, 19);
    store8(buf + 10, 0x54);  # 'T'
    store8(buf + 19, 0x5A);  # 'Z'
    return str_new(buf, 20);
}

fn report_render_sarif(report) {
    var sarif = json_v_obj_new();
    json_v_obj_set(sarif, str_from("$schema"), json_v_str_new(str_from(SARIF_SCHEMA_URI)));
    json_v_obj_set(sarif, str_from("version"), json_v_str_new(str_from("2.1.0")));

    # Build the single run
    var run = json_v_obj_new();

    # Tool object
    var tool = json_v_obj_new();
    var driver = json_v_obj_new();
    json_v_obj_set(driver, str_from("name"), json_v_str_new(str_from("phylax")));
    json_v_obj_set(driver, str_from("version"), report_json_str(load64(report + 16)));
    json_v_obj_set(driver, str_from("informationUri"), json_v_str_new(str_from(PHYLAX_INFO_URI)));
    json_v_obj_set(tool, str_from("driver"), driver);
    json_v_obj_set(run, str_from("tool"), tool);

    # Results array
    var sarif_results = json_v_arr_new();
    var nresults = vec_len(load64(report + 24));

    for (var i = 0; i < nresults; i = i + 1) {
        var r = vec_get(load64(report + 24), i);
        var nf = vec_len(load64(r + 8));

        for (var j = 0; j < nf; j = j + 1) {
            var f = vec_get(load64(r + 8), j);
            var sr = json_v_obj_new();

            json_v_obj_set(sr, str_from("ruleId"), report_json_str(load64(f + 24)));

            # Map severity to SARIF level
            var level = str_from("note");
            if (load64(f + 16) == SEVERITY_CRITICAL) { level = str_from("error"); }
            if (load64(f + 16) == SEVERITY_HIGH)     { level = str_from("error"); }
            if (load64(f + 16) == SEVERITY_MEDIUM)   { level = str_from("warning"); }
            if (load64(f + 16) == SEVERITY_LOW)      { level = str_from("note"); }
            json_v_obj_set(sr, str_from("level"), json_v_str_new(level));

            # Message
            var msg = json_v_obj_new();
            json_v_obj_set(msg, str_from("text"), report_json_str(load64(f + 32)));
            json_v_obj_set(sr, str_from("message"), msg);

            # Location — physical location with artifact URI
            var locations = json_v_arr_new();
            var loc = json_v_obj_new();
            var phys = json_v_obj_new();
            var artifact = json_v_obj_new();
            json_v_obj_set(artifact, str_from("uri"), report_json_str(load64(load64(r) + 8)));
            json_v_obj_set(phys, str_from("artifactLocation"), artifact);
            json_v_obj_set(loc, str_from("physicalLocation"), phys);
            json_v_arr_push(locations, loc);
            json_v_obj_set(sr, str_from("locations"), locations);

            # Properties — extra metadata
            var props = json_v_obj_new();
            json_v_obj_set(props, str_from("severity"), report_json_str(severity_name(load64(f + 16))));
            json_v_obj_set(props, str_from("category"), report_json_str(category_name(load64(f + 8))));
            json_v_obj_set(props, str_from("timestamp"), json_v_int_new(load64(f + 48)));
            json_v_obj_set(sr, str_from("properties"), props);

            json_v_arr_push(sarif_results, sr);
        }
    }

    json_v_obj_set(run, str_from("results"), sarif_results);

    # Invocation
    var invocations = json_v_arr_new();
    var inv = json_v_obj_new();
    json_v_obj_set(inv, str_from("executionSuccessful"), json_v_bool_new(1));
    json_v_obj_set(inv, str_from("startTimeUtc"), json_v_str_new(sarif_rfc3339(load64(report + 8))));
    json_v_arr_push(invocations, inv);
    json_v_obj_set(run, str_from("invocations"), invocations);

    var runs = json_v_arr_new();
    json_v_arr_push(runs, run);
    json_v_obj_set(sarif, str_from("runs"), runs);

    return json_v_build(sarif);
}
