# ================================================================
# Quarantine — Structs
# ================================================================

struct QuarantineEntry {
    id;              # Str — UUID-like identifier
    original_path;   # Str — where the file came from
    quarantine_path; # Str — where it lives now
    reason;          # Str — why it was quarantined
    timestamp;       # i64 — unix epoch seconds
    sha256;          # Str — hash of the file at quarantine time
    size;            # i64 — file size in bytes
}

struct QuarantineManager {
    dir;             # Str — quarantine directory path
    entries;         # Vec of QuarantineEntry
    index_path;      # Str — path to index.json
    next_counter;    # i64 — monotonic counter for ID generation
}

# Every path in this module is a Str, matching the struct comments above.
# The syscall wrappers (sys_mkdir, sys_rename, file_write_all, and
# phylax_read_file) all take NUL-terminated cstrs, so each of those call
# sites converts explicitly with str_to_cstr — a Str handed straight to a
# syscall passes the 16-byte fat-pointer header as if it were the path.

# ================================================================
# Quarantine — ID generation
# ================================================================

# Format an i64 as a lowercase hex Str.
#
# NOT fmt_hex — that one PRINTS to stdout and returns 0, so the pre-1.2.6
# `str_cat(fmt_hex(ts), ...)` here both spewed the digits to stdout and then
# dereferenced 0 as a Str, making every quarantine_file() call SIGSEGV.
# fmt_hex_buf is the buffer-filling variant and returns the length.
fn quarantine_hex(n) {
    var buf = alloc(17);
    var len = fmt_hex_buf(n, buf);
    return str_new(buf, len);
}

# Generate a UUID-like identifier from timestamp and counter.
# Format: hex(timestamp)-hex(counter) — not a true UUID but unique enough.
fn quarantine_gen_id(mgr) {
    var ts = clock_epoch_secs();
    var ctr = load64(mgr + 24);
    store64(mgr + 24, load64(mgr + 24) + 1);

    var id_str = str_cat(quarantine_hex(ts), str_from("-"));
    id_str = str_cat(id_str, quarantine_hex(ctr));
    return id_str;
}

# ================================================================
# Quarantine — Path validation
# ================================================================

# Validate an ID string: reject path separators and directory traversal.
# Returns 1 if valid, 0 if the ID contains dangerous characters.
fn quarantine_validate_id(id) {
    var len = str_len(id);
    if (len == 0) { return 0; }

    # Check for forbidden substrings
    var s = id;
    var data = str_data(s);

    for (var i = 0; i < len; i = i + 1) {
        var ch = load8(data + i);
        # Reject '/' (0x2F), '\' (0x5C)
        if (ch == 0x2F) { return 0; }
        if (ch == 0x5C) { return 0; }
    }

    # Reject ".." anywhere in the string
    if (len >= 2) {
        for (var i = 0; i < len - 1; i = i + 1) {
            var c0 = load8(data + i);
            var c1 = load8(data + i + 1);
            if (c0 == 0x2E) {
                if (c1 == 0x2E) {
                    return 0;
                }
            }
        }
    }

    return 1;
}

# ================================================================
# Quarantine — Core functions
# ================================================================

# Create a new quarantine manager. Creates the directory if needed,
# and attempts to load an existing index.json.
fn quarantine_new(dir) {
    var mgr = alloc(32);
    store64(mgr, dir);
    store64(mgr + 8, vec_new());
    store64(mgr + 24, 1);
    store64(mgr + 16, path_join(dir, str_from("index.json")));

    # Create quarantine directory (mode 0700 = 448 decimal).
    # Use the stdlib's `sys_mkdir` wrapper rather than `syscall(SYS_MKDIR, ...)`
    # directly — aarch64 Linux doesn't expose a bare `mkdir` syscall
    # (it was deprecated in favor of `mkdirat`); `lib/syscalls_aarch64_linux.cyr`
    # defines `sys_mkdir` as a `syscall(SYS_MKDIRAT, AT_FDCWD, path, mode)`
    # shim, and `lib/syscalls_x86_64_linux.cyr` defines it as a direct
    # `syscall(SYS_MKDIR, path, mode)`. Going through the wrapper keeps
    # this path arch-portable.
    sys_mkdir(str_to_cstr(dir), 448);

    # Try to load an existing index — a missing/unreadable file just means
    # a fresh manager (phylax_read_file returns 0, not an empty Str).
    var idx_data = phylax_read_file(str_to_cstr(load64(mgr + 16)));
    if (idx_data != 0 && str_len(idx_data) > 0) {
        # The index is a JSON array of objects, so it needs the tagged-value
        # parser. `json_parse` returns a FLAT Vec of {key,value} Str pairs
        # with no nesting — the pre-1.2.6 code ran map_get() over those
        # 16-byte pairs as if each were a HashMap, reading past their end.
        var root = json_v_parse(idx_data);
        if (json_v_is_arr(root) == 1) {
            var count = json_v_arr_len(root);
            for (var i = 0; i < count; i = i + 1) {
                var item = json_v_arr_get(root, i);
                var entry = alloc(56);
                store64(entry, json_v_str(json_v_obj_get(item, "id")));
                store64(entry + 8, json_v_str(json_v_obj_get(item, "original_path")));
                store64(entry + 16, json_v_str(json_v_obj_get(item, "quarantine_path")));
                store64(entry + 24, json_v_str(json_v_obj_get(item, "reason")));
                store64(entry + 32, json_v_int(json_v_obj_get(item, "timestamp")));
                store64(entry + 40, json_v_str(json_v_obj_get(item, "sha256")));
                store64(entry + 48, json_v_int(json_v_obj_get(item, "size")));
                vec_push(load64(mgr + 8), entry);
            }
            store64(mgr + 24, count + 1);
        }
    }

    return mgr;
}

# Save the current index to disk as a JSON array of objects.
fn quarantine_save_index(mgr) {
    var items = json_v_arr_new();
    var count = vec_len(load64(mgr + 8));
    for (var i = 0; i < count; i = i + 1) {
        var e = vec_get(load64(mgr + 8), i);
        var m = json_v_obj_new();
        json_v_obj_set(m, str_from("id"), report_json_str(load64(e)));
        json_v_obj_set(m, str_from("original_path"), report_json_str(load64(e + 8)));
        json_v_obj_set(m, str_from("quarantine_path"), report_json_str(load64(e + 16)));
        json_v_obj_set(m, str_from("reason"), report_json_str(load64(e + 24)));
        json_v_obj_set(m, str_from("timestamp"), json_v_int_new(load64(e + 32)));
        json_v_obj_set(m, str_from("sha256"), report_json_str(load64(e + 40)));
        json_v_obj_set(m, str_from("size"), json_v_int_new(load64(e + 48)));
        json_v_arr_push(items, m);
    }
    # `json_build` can only emit a flat {"k":"v"} object from a Vec of Str
    # pairs — fed this Vec of maps it read each map header as a pair and
    # dereferenced the entries pointer as a Str. json_v_build nests, keeps
    # timestamp/size as integers, and escapes paths.
    var json_str = json_v_build(items);
    # mgr+16 is the index.json PATH (set via path_join in the ctor, read
    # back by phylax_read_file), not an fd — so write the whole file by
    # path. The prior `file_write(path, json_str)` was doubly wrong: it
    # passed a path where an fd is expected AND omitted the length arg, so
    # the index was silently never persisted. 6.3.x's arity check surfaced
    # it. (migration 1.2.2) file_open still wants a cstr, so convert.
    # file_write_all takes a RAW buffer pointer, so pass str_data(json_str),
    # not the Str header — the header's own 16 bytes are not the payload.
    file_write_all(str_to_cstr(load64(mgr + 16)), str_data(json_str), str_len(json_str));
}

# Quarantine a file: move it into the quarantine directory, record metadata.
# Returns the QuarantineEntry on success, or 0 on failure.
fn quarantine_file(mgr, source_path, reason) {
    var id = quarantine_gen_id(mgr);
    var dest_path = path_join(load64(mgr), id);

    # Read file to compute size and sha256
    var data = phylax_read_file(str_to_cstr(source_path));
    var data_len = 0;
    if (data != 0) { data_len = str_len(data); }
    if (data_len == 0) {
        var msg = str_from("quarantine: cannot read source file");
        sakshi_error(str_data(msg), str_len(msg));
        return 0;
    }

    # Compute SHA-256 of the file data (file_sha256 routes through
    # analyze.cyr to bypass sigil's bundled-hex_encode collision —
    # see file_sha256 for the full story).
    var hash = file_sha256(str_data(data), data_len);

    # Move the file via rename — sys_rename is the portable wrapper
    # provided by `src/syscall_x86_64_linux.cyr` / `src/syscall_aarch64_linux.cyr`
    # (aarch64 composes through SYS_RENAMEAT since bare rename was
    # dropped on the generic-table arches).
    var rc = sys_rename(str_to_cstr(source_path), str_to_cstr(dest_path));
    if (rc < 0) {
        var msg = str_from("quarantine: rename failed");
        sakshi_error(str_data(msg), str_len(msg));
        return 0;
    }

    # Build entry
    var entry = alloc(56);
    store64(entry, id);
    store64(entry + 8, source_path);
    store64(entry + 16, dest_path);
    store64(entry + 24, reason);
    store64(entry + 32, clock_epoch_secs());
    store64(entry + 40, hash);
    store64(entry + 48, data_len);

    vec_push(load64(mgr + 8), entry);
    quarantine_save_index(mgr);

    var msg = str_cat(str_from("quarantined: "), source_path);
    sakshi_info(str_data(msg), str_len(msg));

    return entry;
}

# Release a quarantined file back to its original location.
# Returns 1 on success, 0 on failure.
fn quarantine_release(mgr, id) {
    if (quarantine_validate_id(id) == 0) {
        var msg = str_from("quarantine_release: invalid id");
        sakshi_error(str_data(msg), str_len(msg));
        return 0;
    }

    var count = vec_len(load64(mgr + 8));
    var found_idx = -1;
    var entry = 0;

    for (var i = 0; i < count; i = i + 1) {
        var e = vec_get(load64(mgr + 8), i);
        if (str_eq(load64(e), id)) {
            found_idx = i;
            entry = e;
            i = count;  # break
        }
    }

    if (found_idx < 0) {
        var msg = str_from("quarantine_release: id not found");
        sakshi_error(str_data(msg), str_len(msg));
        return 0;
    }

    # Move file back to original location (sys_rename composes through
    # SYS_RENAMEAT on aarch64; see quarantine_file above).
    var rc = sys_rename(str_to_cstr(load64(entry + 16)), str_to_cstr(load64(entry + 8)));
    if (rc < 0) {
        var msg = str_from("quarantine_release: rename failed");
        sakshi_error(str_data(msg), str_len(msg));
        return 0;
    }

    # Remove from entries — rebuild vec without found_idx
    var new_entries = vec_new();
    for (var i = 0; i < count; i = i + 1) {
        if (i != found_idx) {
            vec_push(new_entries, vec_get(load64(mgr + 8), i));
        }
    }
    store64(mgr + 8, new_entries);
    quarantine_save_index(mgr);

    var msg = str_cat(str_from("released: "), load64(entry + 8));
    sakshi_info(str_data(msg), str_len(msg));

    return 1;
}

# Return the vec of quarantine entries.
fn quarantine_list(mgr) {
    return load64(mgr + 8);
}

# Return the number of quarantined files.
fn quarantine_count(mgr) {
    return vec_len(load64(mgr + 8));
}
