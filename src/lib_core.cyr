# phylax core — detection primitives only, no orchestration/integration
# Matches the [lib.core] profile in cyrius.cyml. Consumers that pull
# dist/phylax-core.cyr get this surface — no bote/majra/HTTP transitive deps.
#
# Explicit opt-in for sigil's crypto-bank (`cbank()`) path — see the
# matching note in src/lib.cyr. hashing.cyr/analyze.cyr route `sha256`
# through `thread_local_*`, which cyrius 6.2.x won't auto-include
# (no first-party reference), so declare it here to define the symbols.
include "lib/thread_local.cyr"
include "src/syscall_x86_64_linux.cyr"
include "src/syscall_aarch64_linux.cyr"
include "src/types.cyr"
include "src/utils.cyr"
include "src/analyze.cyr"
include "src/strings.cyr"
include "src/script.cyr"
include "src/hashing.cyr"
include "src/pe.cyr"
include "src/elf.cyr"
include "src/archive.cyr"
include "src/yara.cyr"
include "src/report.cyr"
